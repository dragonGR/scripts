#!/usr/bin/env bash

# Enable strict mode for better error handling
set -euo pipefail

# Define color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
RESET='\033[0m'

# Function to print messages in color
print_message() {
    local color="$1"
    local message="$2"
    echo -e "${BOLD}${color}${message}${RESET}"
}

# Function to check for yay installation
check_yay_installed() {
    if ! command -v yay &>/dev/null; then
        print_message "$RED" "Error: 'yay' is not installed. Install it to manage AUR packages."
        exit 1
    fi
}

# Function to check if the script is run with sudo
check_sudo() {
    if [ "$EUID" -ne 0 ]; then
        print_message "$RED" "This script must be run with sudo."
        exit 1
    fi
}

# Start script
check_sudo
print_message "$YELLOW" "== System Update Script =="

# Update the package list
print_message "$GREEN" "Updating package list..."
if sudo pacman -Syu --noconfirm; then
    print_message "$GREEN" "Package list updated."
else
    print_message "$RED" "Failed to update package list."
    exit 1
fi

# Clean up orphaned packages
print_message "$YELLOW" "Cleaning up orphaned packages..."
if sudo pacman -Rns $(pacman -Qdtq) --noconfirm 2>/dev/null; then
    print_message "$GREEN" "Orphaned packages cleaned."
else
    print_message "$YELLOW" "No orphaned packages to clean."
fi

# Check for yay installation
check_yay_installed

# Update the AUR packages
print_message "$YELLOW" "Updating AUR packages using yay..."
if sudo -u "$SUDO_USER" yay -Syu --noconfirm; then
    print_message "$GREEN" "AUR packages updated."
else
    print_message "$RED" "Failed to update AUR packages."
    exit 1
fi

# Final message
print_message "$GREEN" "System update complete."
